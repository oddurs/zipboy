#!/bin/sh
set -eu

# The one seam CI and git hooks call. Verbs: fmt fmt:check lint test build version check package

cd "$(dirname "$0")/.."

# Prints "<short_version> <build_number>" for the git repository at $1 (default ".").
# Exact tags stamp their version; commits past a prerelease tag (v0.1.0-rc.1) stamp its target
# version with -dev (0.1.0-dev); commits past a release tag (v0.1.0) bump the patch and add -dev
# (0.1.1-dev); repositories with no tag yet stamp 0.1.0-dev.
version_for_repo() (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
    repo="${1:-.}"
    if exact_tag="$(git -C "$repo" describe --tags --exact-match 2>/dev/null)"; then
        short_ver="${exact_tag#v}"
    else
        latest_tag="$(git -C "$repo" describe --tags --abbrev=0 2>/dev/null || true)"
        base="${latest_tag#v}"
        if [ -z "$base" ]; then
            short_ver="0.1.0-dev"
        elif [ "${base#*-}" != "$base" ]; then
            short_ver="${base%%-*}-dev"
        else
            IFS=. read -r major minor patch <<EOF
$base
EOF
            short_ver="${major:-0}.${minor:-1}.$(( ${patch:-0} + 1 ))-dev"
        fi
    fi
    build_num="$(git -C "$repo" rev-list --count HEAD 2>/dev/null || echo "1")"
    printf '%s %s\n' "$short_ver" "$build_num"
)

# Command Line Tools ship Swift Testing outside the default search paths;
# Xcode does not need this.
test_flags() {
    dev="$(xcode-select -p)"
    case "$dev" in
    */CommandLineTools)
        fw="$dev/Library/Developer/Frameworks"
        lib="$dev/Library/Developer/usr/lib"
        printf '%s\n' -Xswiftc -F -Xswiftc "$fw" -Xlinker -F -Xlinker "$fw" \
            -Xlinker -rpath -Xlinker "$fw" -Xlinker -rpath -Xlinker "$lib"
        ;;
    esac
}

sources="Package.swift Sources Tests scripts/make-icon.swift"

case "${1:-}" in
fmt)
    echo "==> formatting"
    # shellcheck disable=SC2086
    swift format --in-place --recursive $sources
    ;;
fmt:check)
    echo "==> checking format"
    # shellcheck disable=SC2086
    swift format lint --strict --recursive $sources
    ;;
lint)
    "$0" fmt:check
    echo "==> building with warnings as errors"
    swift build -Xswiftc -warnings-as-errors
    ;;
test)
    # An optional second argument runs only the tests whose names match it.
    echo "==> running tests${2:+ matching $2}"
    # shellcheck disable=SC2046
    swift test $(test_flags) ${2:+--filter "$2"}
    ;;
build)
    # One build per architecture, joined with lipo: `--arch a --arch b`
    # needs Xcode's build system, which Command Line Tools lack.
    bins=""
    extensions="ZipboyQuickLook ZipboyThumbnail"
    for arch in arm64 x86_64; do
        echo "==> building release for $arch"
        swift build -c release --triple "$arch-apple-macosx14.0"
        dir="$(swift build -c release --triple "$arch-apple-macosx14.0" --show-bin-path)"
        bins="$bins $dir/Zipboy"
    done
    app="build/Zipboy.app"
    echo "==> assembling $app"
    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    # shellcheck disable=SC2086
    lipo -create $bins -output "$app/Contents/MacOS/Zipboy"
    cp Resources/Info.plist "$app/Contents/"
    cp Resources/AppIcon.icns Resources/AppIconDark.icns Resources/Zipboy.sdef "$app/Contents/Resources/"
    cp -R Resources/Mugi "$app/Contents/Resources/"
    # Each Quick Look extension is a bundle of its own in PlugIns, its plist in Resources/<name>/.
    for ext in $extensions; do
        appex="$app/Contents/PlugIns/$ext.appex"
        mkdir -p "$appex/Contents/MacOS"
        lipo -create \
            "$(swift build -c release --triple arm64-apple-macosx14.0 --show-bin-path)/$ext" \
            "$(swift build -c release --triple x86_64-apple-macosx14.0 --show-bin-path)/$ext" \
            -output "$appex/Contents/MacOS/$ext"
        cp "Resources/${ext#Zipboy}/Info.plist" "$appex/Contents/"
    done
    read -r short_ver build_num <<EOF
$(version_for_repo .)
EOF
    for plist in "$app/Contents/Info.plist" "$app"/Contents/PlugIns/*.appex/Contents/Info.plist; do
        /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $short_ver" "$plist"
        /usr/libexec/PlistBuddy -c "Set :CFBundleVersion $build_num" "$plist"
    done
    # Inside out: each extension is sealed, sandboxed as every app extension must be, before the app.
    for appex in "$app"/Contents/PlugIns/*.appex; do
        codesign --force --sign - --options runtime --entitlements Resources/QuickLook/QuickLook.entitlements "$appex"
    done
    # The Help Book: pages from HelpTopics, indexed for the Help menu's search, sealed with the app.
    book="$app/Contents/Resources/Zipboy.help"
    "$(swift build -c release --triple arm64-apple-macosx14.0 --show-bin-path)/ZipboyHelpBook" "$book" "$short_ver"
    hiutil -I corespotlight -Caf "$book/Contents/Resources/en.lproj/Zipboy.cshelpindex" "$book/Contents/Resources/en.lproj"
    hiutil -I lsm -Caf "$book/Contents/Resources/en.lproj/Zipboy.helpindex" "$book/Contents/Resources/en.lproj"
    codesign --force --sign - --options runtime "$app"
    echo "==> built $app"
    ;;
package)
    # A release DMG for version $2 (such as 0.1.0, from tag v0.1.0): the built app stamped with that
    # version, beside an Applications link so it can be dragged across.
    version="${2:-}"
    [ -n "$version" ] || {
        echo "usage: scripts/task package <version>" >&2
        exit 2
    }
    "$0" build
    app="build/Zipboy.app"
    echo "==> stamping $app as $version"
    for plist in "$app/Contents/Info.plist" "$app"/Contents/PlugIns/*.appex/Contents/Info.plist; do
        /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $version" "$plist"
        /usr/libexec/PlistBuddy -c "Set :CFBundleVersion $(git rev-list --count HEAD)" "$plist"
    done
    # Changing Info.plist breaks the seal, so sign again, inside out.
    for appex in "$app"/Contents/PlugIns/*.appex; do
        codesign --force --sign - --options runtime --entitlements Resources/QuickLook/QuickLook.entitlements "$appex"
    done
    codesign --force --sign - --options runtime "$app"
    dmg="build/Zipboy-$version.dmg"
    stage="build/dmg"
    echo "==> making $dmg"
    rm -rf "$stage" "$dmg"
    mkdir -p "$stage"
    # ditto keeps the bundle's signature and extended attributes intact.
    ditto "$app" "$stage/Zipboy.app"
    ln -s /Applications "$stage/Applications"
    hdiutil create -quiet -volname Zipboy -srcfolder "$stage" -format UDZO -ov "$dmg"
    rm -rf "$stage"
    (cd build && shasum -a 256 "Zipboy-$version.dmg" >"Zipboy-$version.dmg.sha256")
    echo "==> packaged $dmg"
    ;;
version)
    version_for_repo "${2:-.}"
    ;;
check)
    "$0" lint
    "$0" test
    "$0" build
    ;;
*)
    echo "usage: scripts/task {fmt|fmt:check|lint|test [filter]|build|version [repo]|check|package <version>}" >&2
    exit 2
    ;;
esac
