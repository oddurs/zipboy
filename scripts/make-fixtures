#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""Regenerates the archive fixtures in Tests/ZipboyKitTests/Fixtures/matrix.

Each generated archive holds hello.txt ("hello\\n") and dir/world.txt ("world\\n"), with the password
"secret" where it is encrypted. The RAR fixtures there are libarchive's and are not regenerated; nothing
free can write RAR. Needs bsdtar, zip, gzip (all in macOS) and 7zz (`brew install sevenzip`).
"""

import io
import shutil
import struct
import subprocess
import tempfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "Tests/ZipboyKitTests/Fixtures/matrix"
FILES = ["hello.txt", "dir/world.txt"]


def run(cmd: list[str], cwd: Path) -> None:
    subprocess.run(cmd, cwd=cwd, check=True, capture_output=True)


class Unseekable(io.RawIOBase):
    """Makes zipfile write data descriptors, as a streaming writer does."""

    def __init__(self, buffer: io.BytesIO) -> None:
        self.buffer = buffer

    def writable(self) -> bool:
        return True

    def write(self, data: bytes) -> int:  # type: ignore[override]
        return self.buffer.write(data)

    def tell(self) -> int:
        return self.buffer.tell()

    def seekable(self) -> bool:
        return False


def python_zip(
    name: str,
    src: Path,
    method: int = zipfile.ZIP_DEFLATED,
    names: dict[str, str] | None = None,
    zip64: bool = False,
    stream: bool = False,
) -> None:
    buffer = io.BytesIO()
    target = Unseekable(buffer) if stream else buffer
    with zipfile.ZipFile(target, "w", compression=method) as archive:
        for stored, real in (names or {f: f for f in FILES}).items():
            data = (src / real).read_bytes()
            if zip64:
                with archive.open(stored, "w", force_zip64=True) as entry:
                    entry.write(data)
            else:
                archive.writestr(stored, data)
    (OUT / name).write_bytes(buffer.getvalue())


def rename_entry(name: str, placeholder: str, raw: bytes) -> None:
    """Puts raw name bytes in place of an ASCII placeholder in both headers, UTF-8 flag left clear."""
    assert len(placeholder) == len(raw)
    path = OUT / name
    path.write_bytes(path.read_bytes().replace(placeholder.encode(), raw))


def cab_csum(data: bytes, seed: int = 0) -> int:
    csum = seed
    count = len(data) // 4
    for (word,) in struct.iter_unpack("<I", data[: count * 4]):
        csum ^= word
    tail = data[count * 4 :]
    if len(tail) == 3:
        csum ^= (tail[0] << 16) | (tail[1] << 8) | tail[2]
    elif len(tail) == 2:
        csum ^= (tail[0] << 8) | tail[1]
    elif len(tail) == 1:
        csum ^= tail[0]
    return csum


def write_cab(dest: str, src: Path) -> None:
    """Writes an uncompressed Microsoft Cabinet archive holding FILES."""
    entries = [(rel, (src / rel).read_bytes()) for rel in FILES]
    payload = b"".join(data for _, data in entries)
    files_blob = bytearray()
    offset = 0
    for rel, data in entries:
        files_blob += struct.pack("<IIHHHH", len(data), offset, 0, 0x5961, 0, 0x20)
        files_blob += rel.replace("/", "\\").encode("utf-8") + b"\x00"
        offset += len(data)
    coff_files = 36 + 8
    coff_data = coff_files + len(files_blob)
    data_hdr = struct.pack("<HH", len(payload), len(payload))
    cfdata = (
        struct.pack("<I", cab_csum(data_hdr, cab_csum(payload))) + data_hdr + payload
    )
    cfheader = struct.pack(
        "<4sIIIIIBBHHHHH",
        b"MSCF",
        0,
        coff_data + len(cfdata),
        0,
        coff_files,
        0,
        3,
        1,
        1,
        len(entries),
        0,
        0x1234,
        0,
    )
    cffolder = struct.pack("<IHH", coff_data, 1, 0)
    Path(dest).write_bytes(cfheader + cffolder + bytes(files_blob) + cfdata)


def crc16_arc(data: bytes) -> int:
    crc = 0
    for byte in data:
        crc ^= byte
        for _ in range(8):
            crc = (crc >> 1) ^ 0xA001 if (crc & 1) else (crc >> 1)
    return crc


def write_lha(dest: str, src: Path) -> None:
    """Writes a stored (-lh0-) LHA archive holding FILES."""
    out = bytearray()
    for rel in FILES:
        data = (src / rel).read_bytes()
        name = rel.replace("/", "\\").encode("ascii")
        body = (
            struct.pack(
                "<5sIIIBBB",
                b"-lh0-",
                len(data),
                len(data),
                0x59610000,
                0x20,
                0,
                len(name),
            )
            + name
            + struct.pack("<H", crc16_arc(data))
        )
        out += struct.pack("<BB", len(body), sum(body) & 0xFF) + body + data
    out += b"\x00"
    Path(dest).write_bytes(bytes(out))


def main() -> None:
    if shutil.which("7zz") is None:
        raise SystemExit("make-fixtures: 7zz not found; brew install sevenzip")
    OUT.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp)
        (src / "dir").mkdir()
        (src / "hello.txt").write_text("hello\n")
        (src / "dir/world.txt").write_text("world\n")
        # Compressible enough that 7-Zip really uses Deflate64 rather than storing.
        (src / "big.txt").write_text("zipboy " * 20_000)

        def out(name: str) -> str:
            path = OUT / name
            path.unlink(missing_ok=True)
            print(f"==> {name}")
            return str(path)

        bsd = ["bsdtar", "--format", "zip"]
        run(
            [
                *bsd,
                "--options",
                "zip:compression=store",
                "-cf",
                out("zip-store.zip"),
                *FILES,
            ],
            src,
        )
        run([*bsd, "-cf", out("zip-deflate.zip"), *FILES], src)
        run(
            [
                *bsd,
                "--options",
                "zip:encryption=aes128",
                "--passphrase",
                "secret",
                "-cf",
                out("zip-aes128.zip"),
                *FILES,
            ],
            src,
        )
        run(
            [
                *bsd,
                "--options",
                "zip:encryption=aes256",
                "--passphrase",
                "secret",
                "-cf",
                out("zip-aes256.zip"),
                *FILES,
            ],
            src,
        )
        run(["zip", "-q", "-P", "secret", out("zip-zipcrypto.zip"), *FILES], src)
        (src / "link").symlink_to("hello.txt")
        run(["zip", "-q", "-y", out("zip-symlink.zip"), "hello.txt", "link"], src)
        (src / "link").unlink()
        run(
            ["7zz", "a", "-tzip", "-mm=Deflate64", out("zip-deflate64.zip"), "big.txt"],
            src,
        )
        run(
            ["7zz", "a", "-tzip", "-mm=XZ", out("zip-xz.zip"), *FILES],
            src,
        )
        run(
            ["7zz", "a", "-tzip", "-mm=PPMd", out("zip-ppmd.zip"), *FILES],
            src,
        )

        out("zip-bzip2.zip")
        python_zip("zip-bzip2.zip", src, zipfile.ZIP_BZIP2)
        out("zip-lzma.zip")
        python_zip("zip-lzma.zip", src, zipfile.ZIP_LZMA)
        out("zip-zip64.zip")
        python_zip("zip-zip64.zip", src, zip64=True)
        out("zip-data-descriptor.zip")
        python_zip("zip-data-descriptor.zip", src, stream=True)
        out("zip-backslash.zip")
        python_zip(
            "zip-backslash.zip",
            src,
            names={"hello.txt": "hello.txt", "dir\\world.txt": "dir/world.txt"},
        )
        out("zip-cp437-name.zip")
        python_zip("zip-cp437-name.zip", src, names={"Xber.txt": "hello.txt"})
        rename_entry(
            "zip-cp437-name.zip", "Xber.txt", b"\x81ber.txt"
        )  # "über.txt" in code page 437
        with zipfile.ZipFile(out("zip-empty.zip"), "w"):
            pass

        for name, options in [
            ("7z-lzma2.7z", []),
            ("7z-lzma.7z", ["-m0=LZMA"]),
            ("7z-ppmd.7z", ["-m0=PPMd"]),
            ("7z-bzip2.7z", ["-m0=BZip2"]),
            ("7z-deflate.7z", ["-m0=Deflate"]),
            ("7z-copy.7z", ["-m0=Copy"]),
            ("7z-solid.7z", ["-ms=on"]),
            ("7z-bcj.7z", ["-mf=BCJ"]),
        ]:
            run(["7zz", "a", "-t7z", *options, out(name), *FILES], src)

        run(["bsdtar", "-cf", out("tar.tar"), *FILES], src)
        run(["bsdtar", "--format", "pax", "-cf", out("pax.tar"), *FILES], src)
        run(["bsdtar", "-czf", out("tar-gzip.tar.gz"), *FILES], src)
        run(["bsdtar", "-cjf", out("tar-bzip2.tar.bz2"), *FILES], src)
        run(["bsdtar", "-cJf", out("tar-xz.tar.xz"), *FILES], src)
        run(["bsdtar", "--lzma", "-cf", out("tar-lzma.tar.lzma"), *FILES], src)
        run(["bsdtar", "-cZf", out("tar-compress.tar.Z"), *FILES], src)
        run(["bsdtar", "--uuencode", "-cf", out("tar-uu.tar.uu"), *FILES], src)
        run(["bsdtar", "--format", "cpio", "-cf", out("cpio.cpio"), *FILES], src)
        run(["bsdtar", "--format", "cpio", "-czf", out("cpio-gz.cpgz"), *FILES], src)
        run(["bsdtar", "--format", "xar", "-cf", out("xar.xar"), *FILES], src)
        run(["bsdtar", "--format", "ar", "-cf", out("ar.ar"), "hello.txt"], src)
        write_cab(out("cab.cab"), src)
        write_lha(out("lha.lha"), src)
        # An ISO can't be smaller than about 370 KB; gzipped it is about 1 KB, and libarchive reads it the same.
        iso = src / "iso.iso"
        run(["bsdtar", "--format", "iso9660", "-cf", str(iso), *FILES], src)
        with open(out("iso.iso.gz"), "wb") as gz:
            subprocess.run(["gzip", "-9", "-c", str(iso)], check=True, stdout=gz)
        with open(out("gzip-single.gz"), "wb") as gz:
            subprocess.run(["gzip", "-c", "hello.txt"], cwd=src, check=True, stdout=gz)

    print(f"==> done; {len(list(OUT.iterdir()))} files in {OUT.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
